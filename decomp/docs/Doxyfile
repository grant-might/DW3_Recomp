# Doxygen's settings for the API documentation, run from the repository's
# root by make docs, which writes build/docs/dirs.dox, adds the theme's
# scripts to the header and turns HAVE_DOT off without graphviz. Only the
# settings that differ from doxygen's defaults are here.

PROJECT_NAME           = "Digimon World 3 decomp"
PROJECT_BRIEF          = "The European version, SLES_039.36"
OUTPUT_DIRECTORY       = build/docs
STRIP_FROM_INC_PATH    = include src
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
TYPEDEF_HIDES_STRUCT   = YES
NUM_PROC_THREADS       = 0
QUIET                  = YES
WARN_LOGFILE           = build/docs/warnings.log

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
# in the order they link, as in the source
SORT_MEMBER_DOCS       = NO

INPUT                  = README.md CONTRIBUTING.md TODO.md docs src include build/docs/dirs.dox
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                = external asm build expected disks
# with a path: doxygen 1.9 takes the bare name for any README.md
USE_MDFILE_AS_MAINPAGE = ./README.md
# the C's plain comments as doc comments, for doxygen only
FILTER_PATTERNS        = "*.c=python3 tools/doxygen_filter.py" "*.h=python3 tools/doxygen_filter.py" \
                         "*.md=python3 tools/doxygen_md_filter.py"

SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES

# The build's preprocessor, for the European version, with no assembly and
# the overlays' copies of src/shared/ as one function each
MACRO_EXPANSION        = YES
INCLUDE_PATH           = include src/field/stages src external/psyq_headers/psyq_lib47/include
PREDEFINED             = VERSION_EU=1 VERSION_US=0 SKIP_ASM "OVL_NAME(name)=name" "__attribute__(x)="

GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = external/doxygen-awesome-css/doxygen-awesome.css \
                         external/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
                         external/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES       = external/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                         external/doxygen-awesome-css/doxygen-awesome-paragraph-link.js

# 3,600 functions: graphs of two levels at most
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
MAX_DOT_GRAPH_DEPTH    = 2
DOT_IMAGE_FORMAT       = svg
